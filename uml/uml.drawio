        <mxCell id="eSEEJzMh3V37O2y8JKjw-1" value="Mô tả chức năng quản lí phòng.&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: thêm mới phòng.&lt;/li&gt;&lt;li&gt;des: user muốn thêm mới 1 phòng ban.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;thêm mới một phòng ban vào danh sách phòng ban.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng thêm mới phòng ban từ menu quản lí phòng.&lt;/li&gt;&lt;li&gt;2. user nhập các thông tin cho phòng ban mới.&lt;/li&gt;&lt;li&gt;3. thêm phòng ban mới vào danh sách.&lt;/li&gt;&lt;li&gt;4. thông báo thành công.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;2a. thông tin nhập vào không hợp lệ -&amp;gt; thông báo và cho nhập lại.&lt;/li&gt;&lt;li&gt;2b. phòng ban trùng tên -&amp;gt; thông báo và cho nhập lại.&lt;/li&gt;&lt;li&gt;3a. mặc định trạng thái mới thêm là true.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="580" y="440" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-2" value="Mô tả chức năng quản lí phòng.&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: cập nhật phòng.&lt;/li&gt;&lt;li&gt;des: user muốn cập nhật một phòng ban.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;chỉ được cập nhật đối với phòng ban đang hoạt động.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;cập nhật thông tin phòng muốn chỉnh sửa.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng cập nhật phòng ban từ menu quản lí phòng.&lt;/li&gt;&lt;li&gt;2. user nhập id hoặc tên phòng ban.&lt;/li&gt;&lt;li&gt;3. hiển thị thông tin phòng ban cần cập nhật.&lt;/li&gt;&lt;li&gt;4. user chọn thông tin cần cập nhật.&lt;/li&gt;&lt;li&gt;5. user nhập thông tin mới vào.&lt;/li&gt;&lt;li&gt;6. thông báo thành công.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;2a. không thấy phòng ban trùng khớp -&amp;gt; thông báo và cho nhập lại&lt;/li&gt;&lt;li&gt;2b,5a. thông tin nhập vào không hợp lệ -&amp;gt; thông báo và cho nhập lại&lt;/li&gt;&lt;li&gt;5b. tên phòng ban được sửa mới trùng với tên phòng đã có -&amp;gt; thông báo và cho nhập lại.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1010" y="440" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-3" value="Mô tả chức năng quản lí phòng.&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: xóa phòng ban&lt;/li&gt;&lt;li&gt;des: user muốn xóa một phòng ban.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;chỉ áp dụng đối với phòng ban đang hoạt động.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;chuyển status thành không hoạt động. (false)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng xóa phòng ban từ menu quản lí phòng.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;2. user nhập id hoặc tên phòng ban.&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;3. hiển thị thông tin phòng ban cần xóa và yêu cầu xác nhận.&lt;/li&gt;&lt;li&gt;4. user chọn xác nhận.&lt;/li&gt;&lt;li&gt;5. chuyển trạng thái phòng ban = false&lt;/li&gt;&lt;li&gt;6. thông báo thành công.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;2a. không thấy phòng ban trùng khớp -&amp;gt; thông báo và cho nhập lại&lt;/li&gt;&lt;li&gt;3c. phòng ban đã có nhân viên -&amp;gt; không thể xóa và cho nhập lại.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1440" y="440" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-4" value="Mô tả chức năng quản lí phòng.&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: tìm kiếm phòng ban&lt;/li&gt;&lt;li&gt;des: user muốn tìm và hiển thị thông tin một phòng ban.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;chỉ áp dụng đối với phòng ban đang hoạt động.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;hiển thị thông tin phòng ban cần tìm.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng quản lí phòng.&lt;/li&gt;&lt;li&gt;2. user chọn chức năng tìm kiếm phòng ban.&lt;/li&gt;&lt;li&gt;3. user nhập tên phòng ban.&lt;/li&gt;&lt;li&gt;4. hiển thị thông tin phòng ban cần tìm.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;3a. không thấy phòng ban trùng khớp -&amp;gt; thông báo không tìm thấy.&lt;/li&gt;&lt;li&gt;3b. thông tin nhập vào không hợp lệ -&amp;gt; thông báo và cho nhập lại&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1870" y="440" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-5" value="Mô tả chức năng thống kê.&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: thống kê số lượng nhân viên theo phòng ban.&lt;/li&gt;&lt;li&gt;des: User cần xem số lượng nhân viên hiện tại ở mỗi phòng ban để nắm tình hình tổ chức.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;chỉ thống kê những phòng ban đang hoạt động.&lt;/li&gt;&lt;li&gt;loại trừ nhân viên có trạng thái inactive.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;hiển thị danh sách phòng ban với số nhân viên bên trong.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng thống kê số lượng nhân viên theo từng phòng ban từ menu thống kê.&lt;/li&gt;&lt;li&gt;2.Hệ thống thống kê số lượng nhân viên theo từng phòng ban.&lt;/li&gt;&lt;li&gt;3. Hiển thị danh sách số lượng nhân viên theo từng phòng ban.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;3a. nếu chưa có phòng ban nào -&amp;gt; thông báo trống.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="155" y="930" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-6" value="Mô tả chức năng thống kê.&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: thống kê tất cả nhân viên.&lt;/li&gt;&lt;li&gt;des: User cần xem tổng số lượng nhân viên hiện tại.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;/li&gt;&lt;li&gt;Hiển thị thông tin tất cả nhân viên bao gồm đang làm và đã nghỉ.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng thống kê số lượng nhân viên toàn hệ thống từ menu thống kê.&lt;/li&gt;&lt;li&gt;2. hiển thị tổng số nhân viên.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;2a. nếu chưa có nhân viên -&amp;gt; thông báo trống.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="930" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-7" value="Mô tả chức năng thống kê.&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: tìm phòng ban có nhiều nhân viên nhất.&lt;/li&gt;&lt;li&gt;des: User cần xem thông tin về phòng ban có nhiều nhân viên nhất trong công ty.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;chỉ tính phòng ban đang hoạt động&lt;/li&gt;&lt;li&gt;loại trừ những nhân viên có trạng thái inactive.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;hiển thị thông tin về phòng ban có nhiều nhân viên nhất kèm số nhân viên.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng tìm phòng ban có nhiều nhân viên nhất từ menu thống kê.&lt;/li&gt;&lt;li&gt;2. hiển thị toàn bộ thông tin về phòng ban và số lượng nhân viên đang làm việc tại đây.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;2a. danh sách phòng ban trống -&amp;gt; thông báo trống.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1050" y="930" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-8" value="Mô tả chức năng thống kê.&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: tìm phòng ban có lương cao nhất&amp;nbsp;&lt;/li&gt;&lt;li&gt;des: User muốn biết phòng ban nào có trung bình lương cao nhất.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;chỉ tính phòng ban đang hoạt động&lt;/li&gt;&lt;li&gt;loại trừ những nhân viên có trạng thái inactive.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;hiển thị thông tin về phòng ban và mức lương trung bình / người.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng tìm phòng ban có lương trung bình cao nhất từ menu thống kê.&lt;/li&gt;&lt;li&gt;2. hiển thị toàn bô thông tin về phòng ban và mức lương trung bình / số lượng nhân viên.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;2a. danh sách phòng ban trống -&amp;gt; thông báo trống.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1490" y="930" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-12" value="Mô tả chức năng quản lí nhân viên.&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: hiển thị danh sách nhân viên.&lt;/li&gt;&lt;li&gt;des: user muốn hiển thị danh sách nhân viên và có phân trang, mỗi trang 10 nhân viên. có thể chuyển trang.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;loại trừ những nhân viên có trạng thái inactive.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;hiển thị danh sách nhân viên đã được phân trang&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng hiển thị danh sách nhân viên từ menu quản lí nhân viên.&lt;/li&gt;&lt;li&gt;2. hệ thống lọc ra những nhân viên có trạng thái active, onleave, policyleave.&lt;/li&gt;&lt;li&gt;3. Hiển thị danh sách nhân viên với mỗi trang là 10 nhân viên có các lựa chọn khác.&lt;/li&gt;&lt;ul&gt;&lt;li&gt;next - chuyển đến trang tiếp theo&lt;/li&gt;&lt;li&gt;prev - chuyển đến trang trước đó&lt;/li&gt;&lt;li&gt;back - quay lại&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;3a. danh sách trống -&amp;gt; hiển thị trống&lt;/li&gt;&lt;li&gt;3b. danh sách có 1 trang -&amp;gt; ẩn hai lựa chọn next - prev&lt;/li&gt;&lt;li&gt;3c.&amp;nbsp; duyệt đến trang cuối -&amp;gt; ẩn prev.&lt;/li&gt;&lt;li&gt;3d. đang ở trang đầu -&amp;gt; ẩn next.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="155" y="1420" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-14" value="Mô tả chức năng quản lí nhân viên&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: thêm mới nhân viên&lt;/li&gt;&lt;li&gt;des: user muốn thêm một nhân viên mới và có thể nhập thông tin nhân viên.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;thêm mới nhân viên vào danh sách với trạng thái active..&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng thêm mới nhân viên từ menu quản lí nhân viên.&lt;/li&gt;&lt;li&gt;2. user nhập các thông tin cho nhân viên mới&lt;/li&gt;&lt;li&gt;3. hệ thống thêm nhân viên mới vào danh sách.&lt;/li&gt;&lt;li&gt;4. thông báo thành công.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;2a. thông tin nhập vào không hợp lệ -&amp;gt; thông báo lỗi và yêu cầu nhập lại.&lt;/li&gt;&lt;li&gt;2b. số điện thoại, email, mã nhân viên-&amp;gt; thông báo đã tồn tại và yêu cầu nhập lại.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="590" y="1420" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-15" value="Mô tả chức năng quản lí nhân viên&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: cập nhật thông tin nhân viên&lt;/li&gt;&lt;li&gt;des: user muốn cập nhật thông tin cụ thể của một nhân viên.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;loại trừ nhân viên có trạng thái inactive.&lt;/li&gt;&lt;li&gt;không được cập nhật id.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;thông tin về nhân viên được cập nhật.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng cập nhật nhân viên từ menu quản lí phòng.&lt;/li&gt;&lt;li&gt;2. user nhập id nhân viên.&lt;/li&gt;&lt;li&gt;3. hiển thị thông tin nhân viên cần cập nhật.&lt;/li&gt;&lt;li&gt;4. user chọn thông tin cần cập nhật.&lt;/li&gt;&lt;li&gt;5. user nhập thông tin mới vào.&lt;/li&gt;&lt;li&gt;6. thông báo thành công.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;2a. không thấy id nhân viên trùng khớp -&amp;gt; thông báo lỗi và yêu cầu nhập lại.&lt;/li&gt;&lt;li&gt;2b,5a. thông tin nhập vào không hợp lệ -&amp;gt; thong báo lỗi và yêu cầu nhập lại.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1420" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-17" value="Mô tả chức năng quản lí nhân viên&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: xóa nhân viên&amp;nbsp;&lt;/li&gt;&lt;li&gt;des: user muốn xóa một nhân viên trong hệ thống.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;chỉ áp dụng đối với những nhân viên không có trạng thái inactive&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;chuyển status thành inactive&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng xoá nhân viên từ menu quản lí nhân viên.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;2. user nhập id nhân viên.&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;3. hiển thị thông tin nhân viên cần xóa và yêu cầu xác nhận.&lt;/li&gt;&lt;li&gt;4. user xác nhận xóa&lt;/li&gt;&lt;li&gt;5. hệ thống chuyển trạng thái nhân viên = inactive&lt;/li&gt;&lt;li&gt;6. thông báo thành công.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;2a. không thấy id trùng khớp -&amp;gt; báo lỗi&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1480" y="1420" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-18" value="Mô tả chức năng quản lí nhân viên&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: tìm kiếm nhân viên&lt;/li&gt;&lt;li&gt;des: user muốn tìm và hiển thị thông tin một nhân viên&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;chỉ áp dụng đối với những nhân viên không có trạng thái inactive&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;hiển thị thông tin nhân viên cần tìm.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng tìm kiếm nhân viên nhân viên từ menu quản lí nhân viên.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;2. user nhập tên nhân viên cần tìm.&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;3. user nhập khoảng tuổi của nhân viên (từ min đến max)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;4. hiển thị danh sách nhân viên đáp ứng.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;2a. không thấy tên nhân viên trùng khớp -&amp;gt; thông báo không tìm thấy nhân viên.&lt;/li&gt;&lt;li&gt;3a. min &amp;gt; max -&amp;gt; báo lỗi và yêu cầu nhập lại&lt;/li&gt;&lt;li&gt;3b min = max -&amp;gt; tìm các nhân viên có tuổi bằng.&lt;/li&gt;&lt;li&gt;3c tuổi không hợp lệ -&amp;gt; yêu cầu nhập lại.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1930" y="1420" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="eSEEJzMh3V37O2y8JKjw-19" value="Mô tả chức năng quản lí nhân viên&lt;div&gt;&lt;ul&gt;&lt;li&gt;usecase_name: sắp xếp nhân viên&lt;/li&gt;&lt;li&gt;des: user muốn sắp xếp nhân viên theo lương giảm dần hoặc tên nhân viên tăng dần.&lt;/li&gt;&lt;li&gt;actors: User&lt;/li&gt;&lt;li&gt;pre_condition:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;user đã đăng nhập thành công.&lt;/li&gt;&lt;li&gt;chỉ áp dụng đối với những nhân viên không có trạng thái inactive&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;post_condition:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;hiển thị danh sách nhân viên đã sắp xếp.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;basic_flow:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. user chọn chức năng sắp xếp nhân viên nhân viên từ menu quản lí nhân viên.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;2a. user chọn :&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;sắp xếp nhân viên theo lương giảm dần&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;sắp xếp nhân viên theo tên tăng dần.&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;3. hiển thị danh sách nhân viên đã được sắp xếp&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;sub_flow:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;3a. danh sách nhân viên trống -&amp;gt; báo trống.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="2390" y="1420" width="380" height="420" as="geometry" />
        </mxCell>
